{
  "_meta": {
    "version": "1.0",
    "source": "《结构化学基础》(周公度·段连运, 第5版) 第4章附表 / Cotton《Chemical Applications of Group Theory》附录口径",
    "conventions": {
      "class_order": "按教材附表的类顺序排列；reduce_representation 的 chars 必须按此顺序给。",
      "axis": "z 轴取主轴（C_n 轴）；D_nh 中 C2' 轴取与原子共线者，σv 含 C2' 轴，σd 平分 C2' 轴。",
      "cyclic_merge": "C_n(n>=3)、C_nh(n为奇数)、S_2n、T、Th 中，教材把一对共轭一维复表示合并写成一个 E 表示（特征标 2cos）。这类表示在 irreps 里带 \"merged\": true，约化时按 n=(1/(2h))Σ g_c·χ_i·χ_r 计算，本书把它记为『教材合并约定』。",
      "infinite": "C∞v / D∞h 用简化表（类为 E, 2C_φ, ∞σv[, i, 2S_φ, 2C2]），非整数字符写成 \"2cos(φ)\" 形式的字符串；这类群的约化需按 Σ/Π 计数，工具里由 normal_modes 的线形分支处理。"
    },
    "class_irrep_theorem": "完整（未合并）特征标表里不可约表示数 = 类数；但本表按教材把一对共轭一维复表示并写成一个 E（merged），此时表示数 < 类数是正常的。合并约定下唯一成立的判据是三条：① 全对称表示各字符为 1 且 Σ_c g_c·χ_全对称 = h；② 任意两个不同表示 Σ_c g_c·χ_i·χ_j = 0；③ 自身归一：非 merged 表示 Σ_c g_c·χ_i² = h，merged 表示 = 2h。",
    "known_fixes": [
      {"group": "Oh", "field": "irreps.A2g / A2u @ 8S6",
       "wrong": "A2g 在 8S6 记为 −1、A2u 记为 +1",
       "right": "A2g 在 8S6 = +1，A2u 在 8S6 = −1",
       "why": "(S6)³ = i，故一维表示有 χ(S6)³ = χ(i)：g 表示 χ(i)=+1 ⇒ χ(S6)=+1；u 表示 ⇒ χ(S6)=−1。原写法让 <A1g|A2g> = −16。",
       "found_by": "lead 用 Σ_c g_c·χ_i·χ_j = h·δ_ij 全表扫出"},
      {"group": "Ih", "field": "irreps.T1g/T2g/T1u/T2u @ 15σ",
       "wrong": "四个 T 表示在 15σ 上符号相反",
       "right": "T1g/T2g 的 15σ = −1，T1u/T2u 的 15σ = +1",
       "why": "Ih = I × Ci（i 在中心），g 表示在非真操作上的特征标 = +χ_I(对应真操作)、u 表示取负；15σ ↔ χ_I(15C2) = −1。偏差 ±30 = 15×2 正好指向这一个类。",
       "found_by": "lead 扫出，symmetry-dev 用直积因子化复核"},
      {"group": "D3d", "field": "basis.Eu",
       "wrong": "Eu 装了 (x²-y², xy)",
       "right": "Eu 只装 (x,y)；(x²-y²,xy) 归 Eg",
       "why": "二次齐次多项式是**偶**函数（对 i 不变），不可能落在 u（反对称）表示里；二次函数只能进 g 表示。",
       "found_by": "symmetry-dev 的基函数一致性自校验（用真实群元算 Γ_quad 再约化）"},
      {"group": "D4d", "field": "basis.B1 / basis.E2",
       "wrong": "B1 装了 x²-y²；E2 空着",
       "right": "B1 无二次函数（留空）；x²-y² 与 xy 一起归 E2",
       "why": "x²-y² 与 xy 在 D4d 里同属 E2（一个二维不可约表示的基）；B1 是一维且无二次基。抄表时最容易把 x²-y² 挂到 B1 上。",
       "found_by": "同上"},
      {"group": "S6", "field": "basis.Ag / basis.Eg / basis.Eu",
       "wrong": "Ag 缺 Rz；Eg 缺 (x²-y²,xy)，而 (x²-y²,xy) 误放 Eu",
       "right": "Ag: Rz, x²+y², z²；Eg: (Rx,Ry), (xz,yz), (x²-y²,xy)；Eu: (x,y)",
       "why": "主轴是**映轴**时 Rz 对 C3 不变、对 i 也不变（赝矢量的 i 特征标为 +1），故 Rz 属 Ag 而非 Eg。原写法让 Γ_rot 少一个 Ag，normal_modes('S6', n) 的 Γ_vib 会算错。",
       "found_by": "同上"},
      {"group": "T / Th", "field": "basis.E / basis.Eg",
       "wrong": "T 的 E、Th 的 Eg 空着不给基函数",
       "right": "填 (2z²-x²-y², x²-y²)",
       "why": "6 个二次函数在 T 里分解为 A + E + T（1+2+3 = 6）；E 空着会让 Γ_quad 少两个维度，查基函数时漏掉 E。",
       "found_by": "同上"}
    ]
  },

